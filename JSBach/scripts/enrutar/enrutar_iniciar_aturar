#!/bin/bash

######################################################################
###  Iniciar
######################################################################
fnc_enrutar_iniciar() {
    #echo fnc_enrutar_iniciar

    ip a a "$ENRUTAR_MASC" dev "$ENRUTAR_INT" 
    ip l s dev "$ENRUTAR_INT" up
    sysctl -w net.ipv4.ip_forward=1
    iptables -t nat -A POSTROUTING -o "$ENRUTAR_WAN_INT" -j MASQUERADE
}

######################################################################
###  Aturar
######################################################################
fnc_enrutar_aturar() {
    #echo fnc_enrutar_aturar

    iptables -t nat -D POSTROUTING -o "$ENRUTAR_WAN_INT" -j MASQUERADE
    sysctl -w net.ipv4.ip_forward=0
    ip a d "$ENRUTAR_MASC" dev "$ENRUTAR_INT" 
    ip l s dev "$ENRUTAR_INT" down
}
