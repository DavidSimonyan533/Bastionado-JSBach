#!/bin/bash

######################################################################
###  Estat
######################################################################
fnc_enrutar_estat() {
	if [ "$(cat /proc/sys/net/ipv4/ip_forward)" -eq 1 ]; then
		echo "$ACTIVAT"
	else
		echo "$DESACTIVAT"
	fi
	
	if iptables -t nat -C POSTROUTING -o "$ENRUTAR_WAN_INT" -j MASQUERADE 2>/dev/null; then
   		echo "La regla MASQUERADE ya existe."
	else
   		echo "La regla MASQUERADE no existe."
   		iptables -t nat -A POSTROUTING -o "$ENRUTAR_WAN_INT" -j MASQUERADE
	fi
	
	
}
